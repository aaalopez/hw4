# Copy this file to .env (project root) and fill in real values.
# Never commit the real .env — it's already in .gitignore.

# Portkey virtual key used to reach the chat model (OpenAI-compatible
# endpoint). Required — backend/agent.py raises at startup without it.
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional overrides — safe to leave unset, backend/agent.py falls back
# to these exact defaults.
PORTKEY_MODEL=gpt-4o-mini
PORTKEY_BASE_URL=https://api.portkey.ai/v1
